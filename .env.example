# sovereign — copy to .env, fill in what you use, then: set -a; . ./.env; set +a
# sovereign eval --anthropic (the frontier reference):
ANTHROPIC_API_KEY=
# Optional: higher Hugging Face rate limits for `sovereign download`
HF_TOKEN=
# Optional: where the model and dataset live (default ~/.cache/huggingface); vLLM reads it too
HF_HOME=
